APP_NAME=Smart Vending Machine API
ENVIRONMENT=development

# Local development may use SQLite. Production must use PostgreSQL.
DATABASE_URL=sqlite:///./vending_machine.db

# Generate unique secrets; never commit your real .env file.
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Use a Chapa test key for development. Production requires a live key.
CHAPA_SECRET_KEY=CHASECK_TEST-replace-with-your-test-key
CHAPA_BASE_URL=https://api.chapa.co/v1
CHAPA_MODE=test
CHAPA_WEBHOOK_SECRET=replace-with-a-random-webhook-secret-at-least-32-characters
# Shared secret used by the MCU to claim dispense jobs and report sensor results.
MCU_API_TOKEN=replace-with-a-random-machine-token-at-least-32-characters

# Public HTTPS endpoints when deployed. Callback is a backend route;
# return URL is the browser payment status page.
CHAPA_CALLBACK_URL=https://api.example.com/api/payments/chapa/callback
CHAPA_RETURN_URL=https://store.example.com/payment/result
FRONTEND_ORIGIN=http://localhost:5173

